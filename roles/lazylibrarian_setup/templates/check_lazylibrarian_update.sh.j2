#!/usr/bin/env bash
set -euo pipefail

metrics_file="{{ lazylibrarian_setup_update_metrics_path }}"
current_version="unknown"
latest_version="unknown"
update_available=-1

if image_json="$(docker inspect lazylibrarian 2>/dev/null)"; then
  image_name="$(jq -r '.[0].Config.Image // "unknown"' <<<"${image_json}")"
  if [[ "${image_name}" =~ :version-([[:xdigit:]]{8})$ ]]; then
    current_version="${BASH_REMATCH[1],,}"
  fi
fi

if tag_response="$(curl -fsS --max-time 15 'https://hub.docker.com/v2/repositories/linuxserver/lazylibrarian/tags?page_size=100&name=version-&ordering=last_updated')"; then
  latest_tag="$(jq -r '[.results[].name | select(test("^version-[0-9a-fA-F]{8}$"))] | first // "unknown"' <<<"${tag_response}")"
  if [[ "${latest_tag}" == version-* ]]; then
    latest_version="${latest_tag#version-}"
    latest_version="${latest_version,,}"
  fi
fi

if [[ "${current_version}" =~ ^[[:xdigit:]]{8}$ && "${latest_version}" =~ ^[[:xdigit:]]{8}$ ]]; then
  update_available=0
  if [[ "${current_version}" != "${latest_version}" ]]; then
    update_available=1
  fi
fi

tmp_file="$(mktemp "${metrics_file}.XXXXXX")"
trap 'rm -f "$tmp_file"' EXIT
cat > "${tmp_file}" <<EOF
# HELP lazylibrarian_current_version_info LazyLibrarian image commit currently running.
# TYPE lazylibrarian_current_version_info gauge
lazylibrarian_current_version_info{version="${current_version}"} 1
# HELP lazylibrarian_latest_version_info Latest LazyLibrarian image commit available.
# TYPE lazylibrarian_latest_version_info gauge
lazylibrarian_latest_version_info{version="${latest_version}"} 1
# HELP lazylibrarian_update_available Whether a newer LazyLibrarian image is available.
# TYPE lazylibrarian_update_available gauge
lazylibrarian_update_available ${update_available}
EOF

chown root:{{ node_exporter_setup_group | default('prometheus') }} "${tmp_file}"
chmod 0644 "${tmp_file}"
mv -f "${tmp_file}" "${metrics_file}"
