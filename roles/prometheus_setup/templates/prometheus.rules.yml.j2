---
# Ansible generated on {{ ansible_date_time.date }} at {{ ansible_date_time.time }}
# See https://prometheus.io/docs/prometheus/latest/configuration/recording_rules/
# for more details.

groups:
- name: cpu-node
  rules:
  - record: job_instance_mode:node_cpu_seconds:avg_rate5m
    expr: avg by (job, instance, mode) (rate(node_cpu_seconds_total[5m]))
{% if prometheus_setup_ceph_alerts_enabled | bool %}

- name: ceph
  rules:
{% raw %}
  - alert: CephMetricsAbsent
    expr: absent(ceph_health_status{job="{% endraw %}{{ prometheus_setup_ceph_job_name }}{% raw %}"})
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: No Ceph metrics are being scraped
      description: No active ceph-mgr is serving the prometheus module on any scraped node.

  - alert: CephHealthWarning
    expr: max(ceph_health_status) == 1
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Ceph cluster is in HEALTH_WARN
      description: Run `ceph health detail` on a Proxmox node for details.

  - alert: CephHealthError
    expr: max(ceph_health_status) == 2
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: Ceph cluster is in HEALTH_ERR
      description: Run `ceph health detail` on a Proxmox node for details.

  - alert: CephMonQuorumLost
    expr: max by (ceph_daemon) (ceph_mon_quorum_status) == 0
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: Ceph monitor {{ $labels.ceph_daemon }} is out of quorum

  - alert: CephOSDDown
    expr: max by (ceph_daemon) (ceph_osd_up) == 0
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: Ceph OSD {{ $labels.ceph_daemon }} is down

  - alert: CephOSDOut
    expr: max by (ceph_daemon) (ceph_osd_in) == 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Ceph OSD {{ $labels.ceph_daemon }} is marked out

  - alert: CephOSDNearFull
    expr: max by (ceph_daemon) (ceph_osd_stat_bytes_used / ceph_osd_stat_bytes) > 0.80
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Ceph OSD {{ $labels.ceph_daemon }} is {{ $value | humanizePercentage }} full

  - alert: CephClusterNearFull
    expr: max(ceph_cluster_total_used_bytes / ceph_cluster_total_bytes) > 0.80
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Ceph cluster raw capacity is {{ $value | humanizePercentage }} used

  - alert: CephClusterCriticallyFull
    expr: max(ceph_cluster_total_used_bytes / ceph_cluster_total_bytes) > 0.90
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: Ceph cluster raw capacity is {{ $value | humanizePercentage }} used

  - alert: CephPGsNotActive
    expr: sum(ceph_pg_total) - sum(ceph_pg_active) > 0
    for: 15m
    labels:
      severity: critical
    annotations:
      summary: "{{ $value }} Ceph placement groups are not active"
      description: Inactive PGs block I/O to the affected pools.
{% endraw %}
{% endif %}
{% if prometheus_setup_pihole_alerts_enabled | bool %}

- name: pihole
  rules:
{% raw %}
  - alert: PiholeExporterDown
    expr: up{job="{% endraw %}{{ prometheus_setup_pihole_exporter_job_name }}{% raw %}"} == 0
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: Pi-hole exporter on {{ $labels.instance }} is unreachable
      description: Prometheus cannot scrape the Pi-hole exporter. The exporter service or the host may be down.

  - alert: PiholeMetricsAbsent
    expr: up{job="{% endraw %}{{ prometheus_setup_pihole_exporter_job_name }}{% raw %}"} == 1 unless on (instance) pihole_status
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: Pi-hole exporter on {{ $labels.instance }} returns no Pi-hole data
      description: The exporter is up but cannot read the Pi-hole API. Check pihole-FTL and the exporter password.

  - alert: PiholeBlockingDisabled
    expr: pihole_status == 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Pi-hole blocking is disabled on {{ $labels.instance }}
      description: Ad blocking has been off for 15 minutes. Re-enable it with `pihole enable` or in the web interface.

  - alert: PiholeGravityEmpty
    expr: pihole_domains_being_blocked == 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Pi-hole on {{ $labels.instance }} has no blocklist domains
      description: The gravity database is empty. Run `pihole -g` to rebuild it.
{% endraw %}
{% endif %}
