---
# Ansible generated on {{ ansible_date_time.date }} at {{ ansible_date_time.time }}
# See https://prometheus.io/docs/prometheus/latest/configuration/recording_rules/
# for more details.

groups:
- name: cpu-node
  rules:
  - record: job_instance_mode:node_cpu_seconds:avg_rate5m
    expr: avg by (job, instance, mode) (rate(node_cpu_seconds_total[5m]))
{% if prometheus_setup_ceph_alerts_enabled | bool %}

- name: ceph
  rules:
{% raw %}
  - alert: CephMetricsAbsent
    expr: absent(ceph_health_status{job="{% endraw %}{{ prometheus_setup_ceph_job_name }}{% raw %}"})
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: No Ceph metrics are being scraped
      description: No active ceph-mgr is serving the prometheus module on any scraped node.

  - alert: CephHealthWarning
    expr: max(ceph_health_status) == 1
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Ceph cluster is in HEALTH_WARN
      description: Run `ceph health detail` on a Proxmox node for details.

  - alert: CephHealthError
    expr: max(ceph_health_status) == 2
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: Ceph cluster is in HEALTH_ERR
      description: Run `ceph health detail` on a Proxmox node for details.

  - alert: CephMonQuorumLost
    expr: max by (ceph_daemon) (ceph_mon_quorum_status) == 0
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: Ceph monitor {{ $labels.ceph_daemon }} is out of quorum

  - alert: CephOSDDown
    expr: max by (ceph_daemon) (ceph_osd_up) == 0
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: Ceph OSD {{ $labels.ceph_daemon }} is down

  - alert: CephOSDOut
    expr: max by (ceph_daemon) (ceph_osd_in) == 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Ceph OSD {{ $labels.ceph_daemon }} is marked out

  - alert: CephOSDNearFull
    expr: max by (ceph_daemon) (ceph_osd_stat_bytes_used / ceph_osd_stat_bytes) > 0.80
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Ceph OSD {{ $labels.ceph_daemon }} is {{ $value | humanizePercentage }} full

  - alert: CephClusterNearFull
    expr: max(ceph_cluster_total_used_bytes / ceph_cluster_total_bytes) > 0.80
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Ceph cluster raw capacity is {{ $value | humanizePercentage }} used

  - alert: CephClusterCriticallyFull
    expr: max(ceph_cluster_total_used_bytes / ceph_cluster_total_bytes) > 0.90
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: Ceph cluster raw capacity is {{ $value | humanizePercentage }} used

  - alert: CephPGsNotActive
    expr: sum(ceph_pg_total) - sum(ceph_pg_active) > 0
    for: 15m
    labels:
      severity: critical
    annotations:
      summary: "{{ $value }} Ceph placement groups are not active"
      description: Inactive PGs block I/O to the affected pools.
{% endraw %}
{% endif %}
{% if prometheus_setup_pihole_alerts_enabled | bool %}

- name: pihole
  rules:
{% raw %}
  - alert: PiholeExporterDown
    expr: up{job="{% endraw %}{{ prometheus_setup_pihole_exporter_job_name }}{% raw %}"} == 0
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: Pi-hole exporter on {{ $labels.instance }} is unreachable
      description: Prometheus cannot scrape the Pi-hole exporter. The exporter service or the host may be down.

  - alert: PiholeMetricsAbsent
    expr: up{job="{% endraw %}{{ prometheus_setup_pihole_exporter_job_name }}{% raw %}"} == 1 unless on (instance) pihole_status
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: Pi-hole exporter on {{ $labels.instance }} returns no Pi-hole data
      description: The exporter is up but cannot read the Pi-hole API. Check pihole-FTL and the exporter password.

  - alert: PiholeBlockingDisabled
    expr: pihole_status == 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Pi-hole blocking is disabled on {{ $labels.instance }}
      description: Ad blocking has been off for 15 minutes. Re-enable it with `pihole enable` or in the web interface.

  - alert: PiholeGravityEmpty
    expr: pihole_domains_being_blocked == 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Pi-hole on {{ $labels.instance }} has no blocklist domains
      description: The gravity database is empty. Run `pihole -g` to rebuild it.
{% endraw %}
{% endif %}
{% if prometheus_setup_service_path_rules_enabled | bool and prometheus_setup_service_path_services | default([]) | length > 0 %}
{%   set J = prometheus_setup_service_path_job_name %}
{%   set SLOW = prometheus_setup_service_path_slow_seconds %}
{%   set FP = prometheus_setup_service_path_front_proxy %}
{%   set BP1 = prometheus_setup_service_path_back_proxy_primary %}
{%   set BP2 = prometheus_setup_service_path_back_proxy_standby %}
{%   macro ps(c, t) %}max by (service) (probe_success{job="{{ J }}",component="{{ c }}",probe_type="{{ t }}"}){% endmacro %}
{%   macro mins(c, t) %}min by (service) (probe_success{job="{{ J }}",component="{{ c }}",probe_type="{{ t }}"}){% endmacro %}
{%   macro pd(c, t) %}max by (service) (probe_duration_seconds{job="{{ J }}",component="{{ c }}",probe_type="{{ t }}"}){% endmacro %}
{%   macro sc(c) %}max by (service) (probe_http_status_code{job="{{ J }}",component="{{ c }}",probe_type="http"}){% endmacro %}
{%   macro n(x) %}max by (service) (service_path:node_health{node="{{ x }}"}){% endmacro %}
{%   macro e(x) %}max by (service) (service_path:edge_health{edge="{{ x }}"}){% endmacro %}
{#     ok/slow/fail pattern: 2 = all probes succeed and fast, 1 = some succeed or slow, 0 = none succeed #}
{%   macro okslow(c, t) %}
      ((({{ mins(c, t) }} == 1) * 2) unless on (service) ({{ pd(c, t) }} > {{ SLOW }}))
      or (({{ ps(c, t) }} == 1) * 0 + 1)
      or ({{ ps(c, t) }} * 0)
{%-  endmacro %}
{%   macro backproxy(bp) %}
      (({{ ps(bp, 'tcp') }} == 0) * 0)
      or (({{ ps(bp, 'http') }} == 1) * 0 + 2)
      or (({{ sc(bp) }} >= 502 <= 504) * 0 + 2)
      or ({{ ps(bp, 'tcp') }} * 0 + 1)
{%-  endmacro %}
{%   macro bphop(bp) %}
      (({{ ps(bp, 'http') }} == 1) * 0 + 2)
      or (({{ sc(bp) }} >= 502 <= 504) * 0)
{%-  endmacro %}
{%   macro fronthop(bp) %}
      max by (service) (probe_success{job="{{ J }}"}) * 0
        + on () group_left () (2 * max(rproxy_backend_reachable{instance="{{ FP }}",backend="{{ bp }}"}))
{%-  endmacro %}

# Service request-path health. Values: 2 = healthy, 1 = degraded/slow/partial, 0 = failed.
# A missing series means "not evaluated" (no data, or the hop cannot be tested because an earlier hop failed);
# the Service Path dashboard renders that as gray/unknown.
- name: service-path
  interval: {{ prometheus_setup_service_path_scrape_interval }}
  rules:
  # ---------- Nodes (components) ----------
  - record: service_path:node_health
    labels: {node: public_dns}
    expr: |
{{ okslow('public_dns', 'dns') }}
  - record: service_path:node_health
    labels: {node: internal_dns}
    expr: |
{{ okslow('internal_dns', 'dns') }}
  # Cloudflare answered with a 52x origin error: the edge itself is up, the origin hop is not.
  - record: service_path:node_health
    labels: {node: cloudflare}
    expr: |
{{ okslow('cloudflare', 'http') }}
      or (({{ sc('cloudflare') }} >= 520 <= 530) * 0 + 2)
      or (({{ sc('cloudflare') }} > 0) * 0 + 1)
  # HTTPS/vhost/oauth2 check fails but TCP 443 answers: TLS, HTTP or auth problem on the front proxy.
  - record: service_path:node_health
    labels: {node: front_proxy}
    expr: |
      ((({{ ps(FP, 'http') }} == 1) * 2) unless on (service) ({{ pd(FP, 'http') }} > {{ SLOW }}))
      or (({{ ps(FP, 'http') }} == 1) * 0 + 1)
      or (({{ ps(FP, 'tcp') }} == 1) * 0 + 1)
      or ({{ ps(FP, 'tcp') }} * 0)
  # Back proxy is healthy when its vhost probe succeeds, or it answers 502-504 (nginx itself is fine, its
  # upstream is not). Any other answer (e.g. 301 = vhost missing, default server) is degraded.
  - record: service_path:node_health
    labels: {node: back_proxy_primary}
    expr: |
{{ backproxy(BP1) }}
  - record: service_path:node_health
    labels: {node: back_proxy_standby}
    expr: |
{{ backproxy(BP2) }}
  # Host is up when it answers ping or accepts connections on the application port.
  - record: service_path:node_health
    labels: {node: host}
    expr: |
      ((({{ ps('host', 'icmp') }} == 1) or ({{ ps('app', 'tcp') }} == 1)) * 0 + 2)
      or ({{ ps('host', 'icmp') }} * 0)
  - record: service_path:node_health
    labels: {node: app}
    expr: |
{{ okslow('app', 'http') }}

  # ---------- Edges (hops) ----------
  - record: service_path:edge_health
    labels: {edge: dns_edge}
    expr: {{ n('public_dns') }}
  # Proven broken only when Cloudflare itself reports it cannot reach the origin (52x).
  - record: service_path:edge_health
    labels: {edge: edge_front}
    expr: |
{{ okslow('cloudflare', 'http') }}
      or (({{ sc('cloudflare') }} >= 520 <= 530) * 0)
  # Internal DNS probe validates that the answer is the front proxy address.
  - record: service_path:edge_health
    labels: {edge: idns_front}
    expr: {{ n('internal_dns') }}
  # Measured from {{ FP }} itself (rproxy_backend_reachable textfile metric, refreshed every 5 minutes).
  - record: service_path:edge_health
    labels: {edge: front_bp1}
    expr: |
{{ fronthop(BP1) }}
  - record: service_path:edge_health
    labels: {edge: front_bp2}
    expr: |
{{ fronthop(BP2) }}
  # A successful vhost probe through the back proxy proves the hop to the backend; 502-504 proves it is broken.
  - record: service_path:edge_health
    labels: {edge: bp1_host}
    expr: |
{{ bphop(BP1) }}
  - record: service_path:edge_health
    labels: {edge: bp2_host}
    expr: |
{{ bphop(BP2) }}
  - record: service_path:edge_health
    labels: {edge: host_app}
    expr: |
      (({{ ps('app', 'tcp') }} == 1) * 0 + 2)
      or (({{ ps('app', 'tcp') }} == 0) * 0)

  # ---------- Traffic flow (drives the animated overlay) ----------
  # Present only on hops that traffic is expected to take right now. The standby back proxy only
  # carries traffic when the primary is down (nginx `backup` upstream).
{%   for edge in ['dns_edge', 'edge_front', 'idns_front', 'host_app'] %}
  - record: service_path:edge_flow
    labels: {edge: {{ edge }}}
    expr: {{ e(edge) }} >= 1
{%   endfor %}
  - record: service_path:edge_flow
    labels: {edge: front_bp1}
    expr: ({{ e('front_bp1') }} >= 1) and on (service) ({{ n('back_proxy_primary') }} >= 1)
  - record: service_path:edge_flow
    labels: {edge: bp1_host}
    expr: ({{ e('bp1_host') }} >= 1) and on (service) ({{ n('back_proxy_primary') }} >= 1)
  - record: service_path:edge_flow
    labels: {edge: front_bp2}
    expr: ({{ e('front_bp2') }} >= 1) and on (service) ({{ n('back_proxy_primary') }} == 0)
  - record: service_path:edge_flow
    labels: {edge: bp2_host}
    expr: ({{ e('bp2_host') }} >= 1) and on (service) ({{ n('back_proxy_primary') }} == 0)

  # ---------- Path summaries ----------
  # Back proxy layer works if either back proxy can reach the backend.
  - record: service_path:node_health
    labels: {node: back_proxy_layer}
    expr: |
      (
        min by (service) (service_path:node_health{node="back_proxy_primary"} or service_path:edge_health{edge="bp1_host"})
          >= on (service)
        min by (service) (service_path:node_health{node="back_proxy_standby"} or service_path:edge_health{edge="bp2_host"})
      )
      or min by (service) (service_path:node_health{node="back_proxy_standby"} or service_path:edge_health{edge="bp2_host"})
      or min by (service) (service_path:node_health{node="back_proxy_primary"} or service_path:edge_health{edge="bp1_host"})
  - record: service_path:path_health
    labels: {path: external}
    expr: |
      min by (service) (
        service_path:node_health{node=~"public_dns|cloudflare|front_proxy|back_proxy_layer|host|app"}
        or service_path:edge_health{edge="edge_front"}
      )
  - record: service_path:path_health
    labels: {path: internal}
    expr: |
      min by (service) (
        service_path:node_health{node=~"internal_dns|front_proxy|back_proxy_layer|host|app"}
      )

  # ---------- Probable failure location ----------
  # First matching condition wins. Codes (dashboard maps them to text):
  #  0 healthy                 1 DNS failure (public and internal)
  #  2 external path: DNS      3 internal path: DNS
  #  4 external path: edge     5 internal path: LAN cannot reach front proxy (Cloudflare can)
  #  6 front proxy failure     7 back proxy failure (both)
  #  8 backend host down       9 application failure
  # 10 front proxy degraded   11 degraded (partial / slow / standby down)
  # 12 external path: Cloudflare cannot reach origin    13 front proxy cannot reach back proxies
  - record: service_path:probable_failure_code
    expr: |
      ((({{ n('public_dns') }} == 0) and on (service) ({{ n('internal_dns') }} == 0)) * 0 + 1)
      or ((({{ n('front_proxy') }} == 0) and on (service) ({{ e('edge_front') }} >= 1)) * 0 + 5)
      or (({{ n('front_proxy') }} == 0) * 0 + 6)
      or ((({{ e('front_bp1') }} == 0) and on (service) ({{ e('front_bp2') }} == 0)) * 0 + 13)
      or ((({{ n('back_proxy_primary') }} == 0) and on (service) ({{ n('back_proxy_standby') }} == 0)) * 0 + 7)
      or (({{ n('host') }} == 0) * 0 + 8)
      or (({{ n('app') }} == 0) * 0 + 9)
      or (({{ n('internal_dns') }} == 0) * 0 + 3)
      or (({{ n('public_dns') }} == 0) * 0 + 2)
      or (({{ e('edge_front') }} == 0) * 0 + 12)
      or (({{ n('cloudflare') }} == 0) * 0 + 4)
      or (({{ n('front_proxy') }} == 1) * 0 + 10)
      or ((
            (min by (service) (service_path:node_health) < 2)
            or (min by (service) (service_path:edge_health) < 2)
          ) * 0 + 11)
      or (max by (service) (service_path:node_health) * 0)
{% endif %}
