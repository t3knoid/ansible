{% if prometheus_setup_pve_exporter_static_configs is defined %}
{% if prometheus_setup_pve_exporter_static_configs | length > 0 %}
  - job_name: '{{ prometheus_setup_pve_exporter_job_name }}'
    metrics_path: /pve
    params:
      module: ['{{ prometheus_setup_pve_exporter_module }}']
      target: ['{{ prometheus_setup_pve_exporter_target }}']
    scrape_interval: 30s

    static_configs:
{% for scrape_config in prometheus_setup_pve_exporter_static_configs %}
      - targets: {{ scrape_config.targets | to_json }}
        labels:
          instance: '{{ scrape_config.labels.instance }}'
          group: '{{ scrape_config.labels.group }}'
{% endfor %}
{% endif %}
{% elif groups['pve_exporter'] | default([]) | length > 0 %}
  - job_name: '{{ prometheus_setup_pve_exporter_job_name }}'
    metrics_path: /pve
    params:
      module: ['{{ prometheus_setup_pve_exporter_module }}']
      target: ['{{ prometheus_setup_pve_exporter_target }}']
    scrape_interval: 30s

    static_configs:
{% for host in groups['pve_exporter'] %}
      - targets: ['{{ global_ip_addresses[host] }}:{{ hostvars[host].pve_exporter_setup_port | default(prometheus_setup_pve_exporter_port) }}']
        labels:
          instance: {{ host }}
          group: {{ host | regex_replace('-[0-9]+$', '') }}
{% endfor %}
