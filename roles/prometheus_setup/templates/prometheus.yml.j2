        labels:
          instance: {{ host }}
          group: {{ host | regex_replace('-[0-9]+$', '') }}
{% endfor %}
{% endif %}

{% if prometheus_setup_nginxlog_exporter_static_configs is defined %}
{% if prometheus_setup_nginxlog_exporter_static_configs | length > 0 %}
