{% endfor %}
{% endif %}
{% elif groups['nginxlog_exporter'] | default([]) | length > 0 %}
  - job_name: 'nginxlog_exporter'
    scrape_interval: 15s
    static_configs:
{% for host in groups['nginxlog_exporter'] %}
      - targets: ['{{ global_ip_addresses[host] }}:{{ hostvars[host].nginxlog_exporter_setup_port | default(4040) }}']
        labels:
          instance: {{ host }}
          group: {{ host | regex_replace('-[0-9]+$', '') }}
{% endfor %}
