      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(count(up{job=\"node\",instance=~\"rproxy-.*\"} == 0) or vector(0))\n+ (count(rproxy_nginx_expected_port_up{job=\"node\",instance=~\"rproxy-.*\"} == 0) or vector(0))\n+ (count(rproxy_backend_reachable{job=\"node\",instance=~\"rproxy-.*\"} == 0) or vector(0))\n+ (count(rproxy_redis_up{job=\"node\",instance=~\"rproxy-.*\"} == 0) or vector(0))\n+ (count(rproxy_oauth2_proxy_port_up{job=\"node\",instance=~\"rproxy-.*\"} == 0) or vector(0))\n+ (count(up{job=\"nginx_exporter\",instance=~\"rproxy-.*\"} == 0) or vector(0))\n+ (count(linux_systemd_service_failed_info{job=\"node\",instance=~\"rproxy-.*\",service=~\"oauth2-proxy.*|nginx.*|redis.*\"}) or vector(0))\n+ (count(absent(rproxy_nginx_expected_port_up{job=\"node\",instance=~\"rproxy-.*\"})) or vector(0))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Reverse Proxy Health",
      "type": "stat",
