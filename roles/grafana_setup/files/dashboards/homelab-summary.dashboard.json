          "expr": "((count((max by (instance) (up{job=\"pihole_exporter\"}) == 0) or (max by (instance) (pihole_status{job=\"pihole_exporter\"}) == 0)) or vector(0)) unless on () absent((max by (instance) (up{job=\"pihole_exporter\"}) == 1) and on (instance) (max by (instance) (pihole_status{job=\"pihole_exporter\"}) == 1)))\nor on () (vector(-1) and on () absent((max by (instance) (up{job=\"pihole_exporter\"}) == 1) and on (instance) (max by (instance) (pihole_status{job=\"pihole_exporter\"}) == 1)))",
