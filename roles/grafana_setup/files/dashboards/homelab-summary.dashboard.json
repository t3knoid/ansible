          "expr": "sum(max by (id) (pve_cpu_usage_ratio{id=~\"node/.+\"}) * max by (id) (pve_cpu_usage_limit{id=~\"node/.+\"})) / sum(max by (id) (pve_cpu_usage_limit{id=~\"node/.+\"})) * 100",
          "instant": false,
          "range": true,
          "legendFormat": "",
          "refId": "A"
