{
    "annotations": {
        "list": []
    },
    "description": "Proxmox guest resource limits and performance. Device-level hardware configuration is available through the Proxmox link on the guest name.",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [
        {
            "asDropdown": false,
            "icon": "dashboard",
            "includeVars": false,
            "keepTime": true,
            "targetBlank": false,
            "title": "Back to Proxmox VE Status",
            "type": "link",
            "url": "/d/proxmox-ve-status"
        }
    ],
    "panels": [
        {
            "id": 1,
            "title": "Guest Resources",
            "description": "Resource limits reported by Proxmox, not a per-device hardware inventory. VM disk capacity is not guest filesystem free space; zero disk usage may mean it is not reported. The guest name links to Proxmox, where Hardware (VM) or Resources (container) shows the complete configuration.",
            "type": "table",
            "pluginVersion": "12.2.0",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 5,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [],
                    "noValue": "N/A",
                    "custom": {
                        "align": "auto",
                        "cellOptions": {
                            "type": "auto"
                        },
                        "inspect": false
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Name"
                        },
                        "properties": [
                            {
                                "id": "links",
                                "value": [
                                    {
                                        "title": "Open in Proxmox",
                                        "url": "https://${__data.fields.Node}:8006/#v1:0:=${__data.fields.ID:percentencode}:4:=summary",
                                        "targetBlank": true
                                    }
                                ]
                            },
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "type": "data-links"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Status"
                        },
                        "properties": [
                            {
                                "id": "mappings",
                                "value": [
                                    {
                                        "type": "value",
                                        "options": {
                                            "0": {
                                                "color": "red",
                                                "text": "stopped"
                                            },
                                            "1": {
                                                "color": "green",
                                                "text": "running"
                                            }
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "type": "color-text"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": "^(Memory Allocated|Disk Capacity)$"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "bytes"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Uptime"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "s"
                            }
                        ]
                    }
                ]
            },
            "options": {
                "cellHeight": "sm",
                "showHeader": true
            },
            "targets": [
                {
                    "expr": "max by (id, node, name, type) (pve_guest_info{id=\"${guest:raw}\"}) * on (id) group_left () max by (id) (pve_up)",
                    "format": "table",
                    "instant": true,
                    "range": false,
                    "refId": "A"
                },
                {
                    "expr": "max by (id) (pve_cpu_usage_limit{id=\"${guest:raw}\"})",
                    "format": "table",
                    "instant": true,
                    "range": false,
                    "refId": "B"
                },
                {
                    "expr": "max by (id) (pve_memory_size_bytes{id=\"${guest:raw}\"})",
                    "format": "table",
                    "instant": true,
                    "range": false,
                    "refId": "C"
                },
                {
                    "expr": "max by (id) (pve_disk_size_bytes{id=\"${guest:raw}\"})",
                    "format": "table",
                    "instant": true,
                    "range": false,
                    "refId": "D"
                },
                {
                    "expr": "max by (id) (pve_uptime_seconds{id=\"${guest:raw}\"})",
                    "format": "table",
                    "instant": true,
                    "range": false,
                    "refId": "E"
                }
            ],
            "transformations": [
                {
                    "id": "joinByField",
                    "options": {
                        "byField": "id",
                        "mode": "outer"
                    }
                },
                {
                    "id": "filterFieldsByName",
                    "options": {
                        "include": {
                            "pattern": "^(id|name|node|type|Value #[A-E])$"
                        }
                    }
                },
                {
                    "id": "organize",
                    "options": {
                        "excludeByName": {},
                        "indexByName": {
                            "id": 0,
                            "name": 1,
                            "node": 2,
                            "type": 3,
                            "Value #A": 4,
                            "Value #B": 5,
                            "Value #C": 6,
                            "Value #D": 7,
                            "Value #E": 8
                        },
                        "renameByName": {
                            "id": "ID",
                            "name": "Name",
                            "node": "Node",
                            "type": "Type",
                            "Value #A": "Status",
                            "Value #B": "vCPUs / CPU Limit",
                            "Value #C": "Memory Allocated",
                            "Value #D": "Disk Capacity",
                            "Value #E": "Uptime"
                        }
                    }
                }
            ]
        },
        {
            "id": 2,
            "title": "Guest CPU Usage",
            "type": "timeseries",
            "pluginVersion": "12.2.0",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 5
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineWidth": 1,
                        "showPoints": "never",
                        "spanNulls": false
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "max by (id) (pve_cpu_usage_ratio{id=\"${guest:raw}\"}) * 100",
                    "legendFormat": "CPU usage",
                    "range": true,
                    "refId": "A"
                }
            ]
        },
        {
            "id": 3,
            "title": "Guest Memory",
            "description": "Memory usage is reported by the hypervisor and may include guest cache, rather than application-only working memory.",
            "type": "timeseries",
            "pluginVersion": "12.2.0",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 5
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes",
                    "min": 0,
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineWidth": 1,
                        "showPoints": "never",
                        "spanNulls": false
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "max by (id) (pve_memory_usage_bytes{id=\"${guest:raw}\"})",
                    "legendFormat": "Used",
                    "range": true,
                    "refId": "A"
                },
                {
                    "expr": "max by (id) (pve_memory_size_bytes{id=\"${guest:raw}\"})",
                    "legendFormat": "Allocated",
                    "range": true,
                    "refId": "B"
                }
            ]
        },
        {
            "id": 4,
            "title": "Guest Disk I/O",
            "type": "timeseries",
            "pluginVersion": "12.2.0",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 13
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps",
                    "min": 0,
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineWidth": 1,
                        "showPoints": "never",
                        "spanNulls": false
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "max by (id) (rate(pve_disk_read_bytes_total{id=\"${guest:raw}\"}[$__rate_interval]))",
                    "legendFormat": "Read",
                    "range": true,
                    "refId": "A"
                },
                {
                    "expr": "max by (id) (rate(pve_disk_written_bytes_total{id=\"${guest:raw}\"}[$__rate_interval]))",
                    "legendFormat": "Write",
                    "range": true,
                    "refId": "B"
                }
            ]
        },
        {
            "id": 5,
            "title": "Guest Network I/O",
            "type": "timeseries",
            "pluginVersion": "12.2.0",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 13
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps",
                    "min": 0,
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineWidth": 1,
                        "showPoints": "never",
                        "spanNulls": false
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "max by (id) (rate(pve_network_receive_bytes_total{id=\"${guest:raw}\"}[$__rate_interval]))",
                    "legendFormat": "Receive",
                    "range": true,
                    "refId": "A"
                },
                {
                    "expr": "max by (id) (rate(pve_network_transmit_bytes_total{id=\"${guest:raw}\"}[$__rate_interval]))",
                    "legendFormat": "Transmit",
                    "range": true,
                    "refId": "B"
                }
            ]
        }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
        "proxmox",
        "pve",
        "guest"
    ],
    "templating": {
        "list": [
            {
                "name": "guest",
                "label": "Guest",
                "type": "query",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "definition": "label_values(pve_guest_info, id)",
                "query": {
                    "query": "label_values(pve_guest_info, id)",
                    "refId": "PrometheusVariableQueryEditor-VariableQuery"
                },
                "refresh": 1,
                "sort": 1,
                "multi": false,
                "includeAll": false,
                "current": {},
                "options": [],
                "regex": "",
                "hide": 0
            }
        ]
    },
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "timepicker": {},
    "timezone": "",
    "title": "Proxmox VE Guest Detail",
    "uid": "proxmox-ve-guest-detail",
    "version": 2,
    "weekStart": ""
}