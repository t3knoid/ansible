          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "expr": "max by (id) (pve_memory_usage_bytes{id=~\"(qemu|lxc)/.+\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D"
        },
        {
          "expr": "max by (id) (pve_memory_size_bytes{id=~\"(qemu|lxc)/.+\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E"
        },
        {
          "expr": "max by (id) (pve_disk_size_bytes{id=~\"(qemu|lxc)/.+\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "F"
        },
        {
          "expr": "max by (id) (pve_disk_usage_bytes{id=~\"(qemu|lxc)/.+\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "G"
        },
        {
          "expr": "max by (id) (pve_uptime_seconds{id=~\"(qemu|lxc)/.+\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "H"
        }
      ],
      "title": "Guest Status and Resources",
      "description": "Disk capacity and usage are Proxmox-reported, not necessarily filesystem usage inside a VM.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "id",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(id|name|node|type|Value #[A-H])$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "type": true,
              "Value #G": true
            },
            "indexByName": {
              "id": 0,
              "name": 1,
              "node": 2,
              "type": 3,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6,
              "Value #D": 7,
              "Value #E": 8,
              "Value #F": 9,
              "Value #G": 10,
              "Value #H": 11
            },
            "renameByName": {
              "id": "ID",
              "name": "Name",
              "node": "Node",
              "type": "Type",
              "Value #A": "Status",
              "Value #B": "CPU Usage",
              "Value #C": "vCPUs / CPU Limit",
              "Value #D": "Memory Used",
              "Value #E": "Memory Allocated",
              "Value #F": "Disk Capacity",
              "Value #G": "Disk Used",
              "Value #H": "Uptime"
            }
          }
        }
      ],
      "type": "table"
    },
