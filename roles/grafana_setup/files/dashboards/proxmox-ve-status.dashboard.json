    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "color": "red",
                        "text": "stopped"
                      },
                      "1": {
                        "color": "green",
                        "text": "running"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Guest details",
                    "url": "/d/proxmox-ve-guest-detail?var-guest=${__data.fields.ID:percentencode}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU Usage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Memory|Disk) (Used|Allocated|Capacity)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (id, node, name, type) (pve_guest_info) * on (id) group_left () (max by (id) (pve_up))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "max by (id) (pve_cpu_usage_ratio{id=~\"(qemu|lxc)/.+\"}) * 100",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "expr": "max by (id) (pve_cpu_usage_limit{id=~\"(qemu|lxc)/.+\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "expr": "max by (id) (pve_memory_usage_bytes{id=~\"(qemu|lxc)/.+\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D"
        },
        {
          "expr": "max by (id) (pve_memory_size_bytes{id=~\"(qemu|lxc)/.+\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E"
        },
        {
          "expr": "max by (id) (pve_disk_size_bytes{id=~\"(qemu|lxc)/.+\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "F"
        },
        {
          "expr": "max by (id) (pve_disk_usage_bytes{id=~\"(qemu|lxc)/.+\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "G"
        },
        {
          "expr": "max by (id) (pve_uptime_seconds{id=~\"(qemu|lxc)/.+\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "H"
        }
      ],
      "title": "Guest Status and Resources",
      "description": "Disk capacity and usage are Proxmox-reported, not necessarily filesystem usage inside a VM.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "id",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(id|name|node|type|Value #[A-H])$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "type": true,
              "Value #G": true
            },
            "indexByName": {
              "id": 0,
              "name": 1,
              "node": 2,
              "type": 3,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6,
              "Value #D": 7,
              "Value #E": 8,
              "Value #F": 9,
              "Value #G": 10,
              "Value #H": 11
            },
            "renameByName": {
              "id": "ID",
              "name": "Name",
              "node": "Node",
              "type": "Type",
              "Value #A": "Status",
              "Value #B": "CPU Usage",
              "Value #C": "vCPUs / CPU Limit",
              "Value #D": "Memory Used",
              "Value #E": "Memory Allocated",
              "Value #F": "Disk Capacity",
              "Value #G": "Disk Used",
              "Value #H": "Uptime"
            }
          }
        }
      ],
      "type": "table"
    }
